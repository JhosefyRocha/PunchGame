[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://entities/level_select.gd" id="1_select"]

[sub_resource type="StyleBoxFlat" id="StylePanel"]
bg_color = Color(0.29, 0.16, 0.06, 0.97)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.91, 0.58, 0.14, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 4

[sub_resource type="StyleBoxFlat" id="StyleButton"]
bg_color = Color(0.12, 0.22, 0.13, 0.82)
border_width_left = 2
border_color = Color(0.91, 0.58, 0.14, 1)
corner_radius_top_left = 1
corner_radius_top_right = 1
corner_radius_bottom_right = 1
corner_radius_bottom_left = 1

[sub_resource type="StyleBoxFlat" id="StyleButtonHover"]
bg_color = Color(0.25, 0.4, 0.2, 1)
border_width_left = 3
border_color = Color(1, 0.72, 0.27, 1)
corner_radius_top_left = 1
corner_radius_top_right = 1
corner_radius_bottom_right = 1
corner_radius_bottom_left = 1

[sub_resource type="StyleBoxFlat" id="StyleButtonPressed"]
bg_color = Color(0.4, 0.25, 0.08, 1)
border_width_left = 3
border_color = Color(1, 0.78, 0.35, 1)

[node name="LevelSelect" type="PanelContainer"]
custom_minimum_size = Vector2(230, 0)
theme_override_styles/panel = SubResource("StylePanel")
script = ExtResource("1_select")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.76, 0.25, 1)
theme_override_colors/font_shadow_color = Color(0.08, 0.04, 0.01, 1)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 16
text = "SELEÇÃO DE FASES"
horizontal_alignment = 1

[node name="Cards" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Hint" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.74, 0.6, 1)
theme_override_font_sizes/font_size = 8
text = "Conclua uma fase para liberar a próxima."
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.96, 0.85, 1)
theme_override_colors/font_hover_color = Color(1, 0.79, 0.34, 1)
theme_override_colors/font_focus_color = Color(1, 0.79, 0.34, 1)
theme_override_font_sizes/font_size = 10
theme_override_styles/normal = SubResource("StyleButton")
theme_override_styles/hover = SubResource("StyleButtonHover")
theme_override_styles/pressed = SubResource("StyleButtonPressed")
theme_override_styles/focus = SubResource("StyleButtonHover")
text = "VOLTAR"

[connection signal="pressed" from="Margin/VBox/BackButton" to="." method="_on_back_button_pressed"]
