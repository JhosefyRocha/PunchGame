[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://entities/game_complete_menu.gd" id="1_complete"]

[sub_resource type="StyleBoxFlat" id="OverlayStyle"]
bg_color = Color(0.025, 0.09, 0.055, 0.76)

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.055, 0.16, 0.09, 0.98)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.72, 0.91, 0.25, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
shadow_color = Color(0, 0, 0, 0.6)
shadow_size = 4

[sub_resource type="StyleBoxFlat" id="ButtonStyle"]
bg_color = Color(0.14, 0.31, 0.16, 1)
border_width_left = 2
border_color = Color(0.93, 0.72, 0.2, 1)

[node name="GameCompleteMenu" type="CanvasLayer"]
process_mode = 3
layer = 30
script = ExtResource("1_complete")

[node name="Overlay" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("OverlayStyle")

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Overlay/Center"]
custom_minimum_size = Vector2(248, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Margin" type="MarginContainer" parent="Overlay/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Overlay/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Title" type="Label" parent="Overlay/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.87, 1, 0.38, 1)
theme_override_colors/font_shadow_color = Color(0.02, 0.08, 0.03, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 21
text = "JOGO CONCLUÍDO!"
horizontal_alignment = 1

[node name="Message" type="Label" parent="Overlay/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.97, 0.84, 1)
theme_override_font_sizes/font_size = 10
text = "0 animais foram libertados!"
horizontal_alignment = 1

[node name="PlayAgainButton" type="Button" parent="Overlay/Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_override_font_sizes/font_size = 10
theme_override_styles/normal = SubResource("ButtonStyle")
theme_override_styles/hover = SubResource("ButtonStyle")
theme_override_styles/focus = SubResource("ButtonStyle")
text = "JOGAR NOVAMENTE"

[node name="MenuButton" type="Button" parent="Overlay/Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_override_font_sizes/font_size = 10
theme_override_styles/normal = SubResource("ButtonStyle")
theme_override_styles/hover = SubResource("ButtonStyle")
theme_override_styles/focus = SubResource("ButtonStyle")
text = "MENU PRINCIPAL"

[connection signal="pressed" from="Overlay/Center/Panel/Margin/VBox/PlayAgainButton" to="." method="_on_play_again_button_pressed"]
[connection signal="pressed" from="Overlay/Center/Panel/Margin/VBox/MenuButton" to="." method="_on_menu_button_pressed"]
