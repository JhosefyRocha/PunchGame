[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://entities/game_menu.gd" id="1_menu"]
[ext_resource type="AudioStream" path="res://sounds/menu_music.ogg" id="2_music"]

[sub_resource type="StyleBoxFlat" id="StyleOverlay"]
bg_color = Color(0.035, 0.055, 0.04, 0.38)

[sub_resource type="StyleBoxFlat" id="StylePanel"]
bg_color = Color(0.09, 0.16, 0.1, 0.97)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.91, 0.58, 0.14, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 4

[sub_resource type="StyleBoxFlat" id="StyleTitlePlate"]
bg_color = Color(0.49, 0.22, 0.07, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.96, 0.67, 0.22, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="StyleButton"]
bg_color = Color(0.12, 0.22, 0.13, 0.82)
border_width_left = 2
border_color = Color(0.91, 0.58, 0.14, 1)
corner_radius_top_left = 1
corner_radius_top_right = 1
corner_radius_bottom_right = 1
corner_radius_bottom_left = 1

[sub_resource type="StyleBoxFlat" id="StyleButtonHover"]
bg_color = Color(0.25, 0.4, 0.2, 1)
border_width_left = 3
border_color = Color(1, 0.72, 0.27, 1)
corner_radius_top_left = 1
corner_radius_top_right = 1
corner_radius_bottom_right = 1
corner_radius_bottom_left = 1

[sub_resource type="StyleBoxFlat" id="StyleButtonPressed"]
bg_color = Color(0.4, 0.25, 0.08, 1)
border_width_left = 3
border_color = Color(1, 0.78, 0.35, 1)

[sub_resource type="StyleBoxEmpty" id="StyleButtonEmpty"]

[node name="GameMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_menu")

[node name="MenuMusic" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_music")
volume_db = -8.0

[node name="Overlay" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleOverlay")

[node name="DeathTint" type="ColorRect" parent="Overlay"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.38, 0.035, 0.025, 0.55)

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuPanel" type="PanelContainer" parent="Overlay/Center"]
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StylePanel")

[node name="Margin" type="MarginContainer" parent="Overlay/Center/MenuPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Overlay/Center/MenuPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="TitlePlate" type="PanelContainer" parent="Overlay/Center/MenuPanel/Margin/VBox"]
custom_minimum_size = Vector2(0, 37)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleTitlePlate")

[node name="Title" type="Label" parent="Overlay/Center/MenuPanel/Margin/VBox/TitlePlate"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.76, 0.25, 1)
theme_override_colors/font_shadow_color = Color(0.08, 0.04, 0.01, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 23
text = "PUNCH GAME"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Subtitle" type="Label" parent="Overlay/Center/MenuPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.7, 0.29, 1)
theme_override_font_sizes/font_size = 9
text = "MENU PRINCIPAL"

[node name="StartButton" type="Button" parent="Overlay/Center/MenuPanel/Margin/VBox"]
custom_minimum_size = Vector2(0, 21)
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.96, 0.85, 1)
theme_override_colors/font_hover_color = Color(1, 0.79, 0.34, 1)
theme_override_font_sizes/font_size = 11
theme_override_styles/normal = SubResource("StyleButton")
theme_override_styles/hover = SubResource("StyleButtonHover")
theme_override_styles/pressed = SubResource("StyleButtonPressed")
theme_override_styles/focus = SubResource("StyleButtonHover")
text = "  ▶  INICIAR JOGO"
alignment = 0

[node name="ControlsButton" type="Button" parent="Overlay/Center/MenuPanel/Margin/VBox"]
