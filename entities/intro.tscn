[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://entities/intro.gd" id="1_intro"]

[sub_resource type="StyleBoxFlat" id="BackgroundStyle"]
bg_color = Color(0.025, 0.055, 0.035, 1)

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.08, 0.18, 0.1, 0.98)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.96, 0.68, 0.16, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="ButtonStyle"]
bg_color = Color(0.14, 0.29, 0.16, 1)
border_width_left = 2
border_color = Color(0.95, 0.67, 0.18, 1)

[node name="Intro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_intro")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("BackgroundStyle")

[node name="Overlay" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Overlay/Center"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Margin" type="MarginContainer" parent="Overlay/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Overlay/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Overlay/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.77, 0.24, 1)
theme_override_font_sizes/font_size = 18
text = "A PELÚCIA"
horizontal_alignment = 1

[node name="Story" type="Label" parent="Overlay/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.87, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 10
text = "Punch vivia tranquilo na floresta até que caçadores invadiram a mata e roubaram a pelúcia de orangotango que ele mais amava.\n\nPara recuperá-la, Punch vai atravessar cada fase, enfrentar os invasores e libertar os animais presos nas gaiolas."
autowrap_mode = 3
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="Overlay/Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
theme_override_styles/normal = SubResource("ButtonStyle")
theme_override_styles/hover = SubResource("ButtonStyle")
theme_override_styles/focus = SubResource("ButtonStyle")
text = "COMEÇAR"

[connection signal="pressed" from="Overlay/Center/Panel/Margin/VBox/ContinueButton" to="." method="_on_continue_button_pressed"]
