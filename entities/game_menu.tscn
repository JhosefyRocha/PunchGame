theme_override_font_sizes/font_size = 11
text = "A / ←   Mover para esquerda\nD / →   Mover para direita\nW / ↑ / Espaço   Pular\nW/S ou ↑/↓   Escalar cipó\nEspaço   Soltar cipó\nE   Atacar\nJ   Interagir / resgatar\nEsc   Abrir ou fechar menu"
horizontal_alignment = 1

